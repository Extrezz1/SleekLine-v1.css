/* Sleekline — Full Bright Orange Text */
:root {
    --sl-text: #FFA63B;
    --sl-text-soft: #FFC78A;
}

/* Make ALL text orange */
body,
html,
* {
    color: var(--sl-text) !important;
}

/* Secondary UI text */
small,
.subtle,
.secondary,
.hint,
.timestamp {
    color: var(--sl-text-soft) !important;
}

/* Sleekline Background */
html,
body {
    background: #F4F4F6 !important;
}

/* Sleekline — Subtle Hover Glitch */
@keyframes sl-glitch-subtle {
    0% {
        transform: translate(0, 0);
    }
    30% {
        transform: translate(0.5px, -0.5px);
    }
    60% {
        transform: translate(-0.5px, 0.5px);
    }
    100% {
        transform: translate(0, 0);
    }
}

.glitch:hover,
p:hover,
span:hover,
div:hover {
    animation: sl-glitch-subtle 80ms steps(2, end);
}

@keyframes sl-distort {
    0% {
        filter: blur(0px);
    }
    50% {
        filter: blur(0.6px);
    }
    100% {
        filter: blur(0px);
    }
}

html::after {
    content: "";
    position: fixed;
    left: 0;
    width: 100%;
    height: 2px;
    background: rgba(255, 166, 59, 0.35);
    backdrop-filter: blur(1px);
    z-index: 9999;
    animation: sl-scan 4s linear infinite,
    sl-distort 4s steps(1, end) infinite;
    pointer-events: none;
}
